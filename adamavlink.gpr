--  MAVLink v2 frames and messages. Pure SPARK with no run-time library
--  needs beyond Interfaces: no tasking, allocation, exceptions raised on
--  purpose, or I/O, so it suits restricted embedded runtimes.
library project AdaMAVLink is
   type Build_Mode is ("release", "dev");
   Mode : Build_Mode := external ("ADAMAVLINK_BUILD_MODE", "release");

   type Library_Kind is ("static", "relocatable", "static-pic");
   Kind : Library_Kind := external ("ADAMAVLINK_LIBRARY_TYPE", "static");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & Mode;
   for Library_Dir use "lib/" & Mode;
   for Library_Name use "adamavlink";
   for Library_Kind use Kind;

   Base_Switches := ("-gnat2022", "-gnatwa", "-gnato", "-gnata");

   package Compiler is
      case Mode is
         --  Warnings are errors in development only, so a newer compiler's
         --  new warnings never break a user's build.
         when "dev"     =>
            for Default_Switches ("Ada") use Base_Switches & ("-gnatwe", "-g");
         when "release" =>
            for Default_Switches ("Ada") use Base_Switches & ("-O2");
      end case;
   end Compiler;
end AdaMAVLink;

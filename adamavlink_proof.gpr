--  GNATprove over the library's sources (make prove).
project AdaMAVLink_Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/proof";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwe");
   end Compiler;
end AdaMAVLink_Proof;
